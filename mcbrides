  <script>
    "use strict";

    const gameShell = document.getElementById("gameShell");
    const arena = document.getElementById("arena");

    const playerFighter = document.getElementById("playerFighter");
    const enemyFighter = document.getElementById("enemyFighter");

    const playerHealthBar = document.getElementById("playerHealthBar");
    const enemyHealthBar = document.getElementById("enemyHealthBar");

    const playerHealthNumber =
      document.getElementById("playerHealthNumber");

    const enemyHealthNumber =
      document.getElementById("enemyHealthNumber");

    const playerPowerBar = document.getElementById("playerPowerBar");
    const enemyPowerBar = document.getElementById("enemyPowerBar");

    const timerElement = document.getElementById("timer");
    const roundNumberElement = document.getElementById("roundNumber");

    const announcement = document.getElementById("announcement");
    const combatText = document.getElementById("combatText");
    const comboMeter = document.getElementById("comboMeter");

    const attackButtons =
      Array.from(document.querySelectorAll(".attack-button"));

    const specialButton = document.getElementById("specialButton");
    const restartButton = document.getElementById("restartButton");

    const finisherOverlay =
      document.getElementById("finisherOverlay");

    const performFinisher =
      document.getElementById("performFinisher");

    const playerRoundDots = [
      document.getElementById("playerRoundOne"),
      document.getElementById("playerRoundTwo")
    ];

    const enemyRoundDots = [
      document.getElementById("enemyRoundOne"),
      document.getElementById("enemyRoundTwo")
    ];

    const moves = {
      potShot: {
        name: "Pot Shot",
        minDamage: 7,
        maxDamage: 12,
        powerGain: 10,
        accuracy: 0.94,
        message: "Bob fires a fistful of soil."
      },

      leafSlap: {
        name: "Leaf Slap",
        minDamage: 11,
        maxDamage: 18,
        powerGain: 7,
        accuracy: 0.79,
        message: "Bob delivers photosynthetic disrespect."
      },

      rootProblem: {
        name: "Root of the Problem",
        minDamage: 8,
        maxDamage: 15,
        powerGain: 18,
        accuracy: 0.84,
        message: "Roots erupt beneath the arena."
      }
    };

    const enemyMoves = [
      {
        name: "Snap Attack",
        minDamage: 7,
        maxDamage: 13,
        powerGain: 9,
        accuracy: 0.9
      },
      {
        name: "Acid Spit",
        minDamage: 10,
        maxDamage: 17,
        powerGain: 11,
        accuracy: 0.78
      },
      {
        name: "Chomp Chomp",
        minDamage: 12,
        maxDamage: 20,
        powerGain: 7,
        accuracy: 0.7
      }
    ];

    let playerHealth = 100;
    let enemyHealth = 100;

    let playerPower = 0;
    let enemyPower = 0;

    let playerRounds = 0;
    let enemyRounds = 0;

    let roundNumber = 1;
    let timeRemaining = 60;

    let timerInterval = null;
    let enemyTurnTimeout = null;

    let fightActive = false;
    let playerBlocking = false;
    let enemyBlocking = false;
    let actionLocked = true;

    let comboCount = 0;
    let comboDeadline = 0;

    let audioContext = null;

    function randomBetween(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }

    function getAudioContext() {
      if (!audioContext) {
        const AudioContextClass =
          window.AudioContext || window.webkitAudioContext;

        if (AudioContextClass) {
          audioContext = new AudioContextClass();
        }
      }

      if (audioContext && audioContext.state === "suspended") {
        audioContext.resume().catch(() => {});
      }

      return audioContext;
    }

    function playTone(
      frequency,
      duration = 0.08,
      type = "square",
      volume = 0.06,
      slideTo = null
    ) {
      const context = getAudioContext();

      if (!context) {
        return;
      }

      const oscillator = context.createOscillator();
      const gain = context.createGain();

      oscillator.type = type;
      oscillator.frequency.setValueAtTime(
        frequency,
        context.currentTime
      );

      if (slideTo) {
        oscillator.frequency.exponentialRampToValueAtTime(
          slideTo,
          context.currentTime + duration
        );
      }

      gain.gain.setValueAtTime(volume, context.currentTime);

      gain.gain.exponentialRampToValueAtTime(
        0.001,
        context.currentTime + duration
      );

      oscillator.connect(gain);
      gain.connect(context.destination);

      oscillator.start();
      oscillator.stop(context.currentTime + duration);
    }

    function playHitSound(strength = 1) {
      playTone(
        95 + strength * 12,
        0.09,
        "sawtooth",
        0.05 + strength * 0.008,
        45
      );

      window.setTimeout(() => {
        playTone(38, 0.12, "square", 0.045);
      }, 25);
    }

    function playBlockSound() {
      playTone(360, 0.08, "triangle", 0.055, 130);
      window.setTimeout(() => {
        playTone(520, 0.05, "square", 0.025);
      }, 35);
    }

    function playMissSound() {
      playTone(210, 0.09, "triangle", 0.035, 90);
    }

    function playFinisherSound() {
      playTone(75, 0.6, "sawtooth", 0.075, 28);

      window.setTimeout(() => {
        playTone(420, 0.28, "square", 0.05, 90);
      }, 210);
    }

    function vibrate(pattern) {
      if ("vibrate" in navigator) {
        navigator.vibrate(pattern);
      }
    }

    function announce(text) {
      announcement.textContent = text;
      announcement.classList.remove("show");

      void announcement.offsetWidth;

      announcement.classList.add("show");
    }

    function setCombatText(text) {
      combatText.textContent = text;
    }

    function enableControls(enabled) {
      attackButtons.forEach((button) => {
        button.disabled = !enabled;
      });

      specialButton.disabled =
        !enabled ||
        playerPower < 100 ||
        enemyHealth > 25;
    }

    function updateHud() {
      playerHealth = clamp(playerHealth, 0, 100);
      enemyHealth = clamp(enemyHealth, 0, 100);

      playerPower = clamp(playerPower, 0, 100);
      enemyPower = clamp(enemyPower, 0, 100);

      playerHealthBar.style.width = playerHealth + "%";
      enemyHealthBar.style.width = enemyHealth + "%";

      playerPowerBar.style.width = playerPower + "%";
      enemyPowerBar.style.width = enemyPower + "%";

      playerHealthNumber.textContent = playerHealth;
      enemyHealthNumber.textContent = enemyHealth;

      timerElement.textContent = timeRemaining;
      roundNumberElement.textContent = roundNumber;

      playerRoundDots.forEach((dot, index) => {
        dot.classList.toggle("won", index < playerRounds);
      });

      enemyRoundDots.forEach((dot, index) => {
        dot.classList.toggle("won", index < enemyRounds);
      });

      enableControls(
        fightActive &&
        !actionLocked &&
        playerHealth > 0 &&
        enemyHealth > 0
      );
    }

    function createImpact(target, damage) {
      const arenaRect = arena.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();

      const impact = document.createElement("div");
      impact.className = "impact";

      impact.style.left =
        targetRect.left -
        arenaRect.left +
        targetRect.width * 0.5 +
        "px";

      impact.style.top =
        targetRect.top -
        arenaRect.top +
        targetRect.height * 0.45 +
        "px";

      arena.appendChild(impact);

      const damageNumber = document.createElement("div");
      damageNumber.className = "damage-number";
      damageNumber.textContent = "-" + damage;

      damageNumber.style.left =
        targetRect.left -
        arenaRect.left +
        targetRect.width * 0.48 +
        "px";

      damageNumber.style.top =
        targetRect.top -
        arenaRect.top +
        targetRect.height * 0.32 +
        "px";

      arena.appendChild(damageNumber);

      window.setTimeout(() => impact.remove(), 550);
      window.setTimeout(() => damageNumber.remove(), 760);
    }

    function animateAttack(attacker, defender, damage, blocked) {
      attacker.classList.add("attack");

      window.setTimeout(() => {
        if (blocked) {
          defender.classList.add("blocking");
          playBlockSound();
          vibrate(25);
        } else {
          defender.classList.add("hit");
          createImpact(defender, damage);
          playHitSound(Math.min(damage / 8, 2.4));
          vibrate([25, 20, 40]);

          gameShell.classList.add("screen-shake");
        }
      }, 105);

      window.setTimeout(() => {
        attacker.classList.remove("attack");
        defender.classList.remove("hit");
        defender.classList.remove("blocking");
        gameShell.classList.remove("screen-shake");
      }, 420);
    }

    function showCombo() {
      const now = Date.now();

      if (now <= comboDeadline) {
        comboCount += 1;
      } else {
        comboCount = 1;
      }

      comboDeadline = now + 1200;

      if (comboCount >= 3) {
        comboMeter.textContent = comboCount + " HIT COMBO!";
        comboMeter.classList.remove("show");

        void comboMeter.offsetWidth;

        comboMeter.classList.add("show");
      }
    }

    function calculateDamage(move, blocking) {
      let damage = randomBetween(move.minDamage, move.maxDamage);

      if (blocking) {
        damage = Math.max(1, Math.floor(damage * 0.28));
      }

      return damage;
    }

    function playerMove(moveKey) {
      if (!fightActive || actionLocked) {
        return;
      }

      getAudioContext();

      if (moveKey === "block") {
        playerBlocking = true;
        actionLocked = true;

        setCombatText("Bob braces his pot.");

        playerFighter.classList.add("blocking");
        playBlockSound();

        window.setTimeout(() => {
          enemyTurn();
        }, 470);

        return;
      }

      const move = moves[moveKey];

      if (!move) {
        return;
      }

      actionLocked = true;
      enableControls(false);

      const hits = Math.random() <= move.accuracy;

      if (!hits) {
        playerFighter.classList.add("attack");
        setCombatText(move.name + " misses. Bob looks inconvenienced.");
        playMissSound();

        window.setTimeout(() => {
          playerFighter.classList.remove("attack");
          enemyTurn();
        }, 600);

        return;
      }

      const damage = calculateDamage(move, enemyBlocking);

      enemyHealth -= damage;
      playerPower += move.powerGain;

      animateAttack(
        playerFighter,
        enemyFighter,
        damage,
        enemyBlocking
      );

      showCombo();

      setCombatText(
        move.message +
        " " +
        (enemyBlocking ? "Flytrap blocks most of it." : "")
      );

      updateHud();

      if (enemyHealth <= 0) {
        window.setTimeout(() => {
          finishRound("player");
        }, 620);

        return;
      }

      if (enemyHealth <= 25 && playerPower >= 100) {
        window.setTimeout(() => {
          actionLocked = false;
          updateHud();
          setCombatText(
            "The Flytrap is vulnerable. KINTSUGI CRUSH is ready."
          );
        }, 650);

        return;
      }

      window.setTimeout(() => {
        enemyTurn();
      }, 720);
    }

    function enemyTurn() {
      if (!fightActive || enemyHealth <= 0 || playerHealth <= 0) {
        return;
      }

      actionLocked = true;
      enableControls(false);

      enemyBlocking = false;

      const shouldBlock =
        Math.random() < 0.18 &&
        playerPower >= 70;

      if (shouldBlock) {
        enemyBlocking = true;
        enemyFighter.classList.add("blocking");

        setCombatText("Flytrap curls inward and blocks.");

        playBlockSound();

        enemyTurnTimeout = window.setTimeout(() => {
          enemyFighter.classList.remove("blocking");
          enemyBlocking = false;
          playerBlocking = false;
          playerFighter.classList.remove("blocking");

          actionLocked = false;
          updateHud();

          setCombatText("Bob’s turn.");
        }, 670);

        return;
      }

      const move =
        enemyMoves[
          Math.floor(Math.random() * enemyMoves.length)
        ];

      const hits = Math.random() <= move.accuracy;

      enemyTurnTimeout = window.setTimeout(() => {
        if (!hits) {
          enemyFighter.classList.add("attack");
          playMissSound();

          setCombatText(
            "Flytrap uses " +
            move.name +
            " and bites absolutely nothing."
          );

          window.setTimeout(() => {
            enemyFighter.classList.remove("attack");
            endEnemyTurn();
          }, 540);

          return;
        }

        let damage = calculateDamage(move, playerBlocking);

        if (enemyPower >= 100 && Math.random() < 0.35) {
          damage += 8;
          enemyPower = 0;

          setCombatText(
            "FLYTRAP FURY! Apparently lunch has become personal."
          );
        } else {
          setCombatText(
            "Flytrap uses " +
            move.name +
            (playerBlocking ? ". Bob blocks most of it." : ".")
          );
        }

        playerHealth -= damage;
        enemyPower += move.powerGain;

        animateAttack(
          enemyFighter,
          playerFighter,
          damage,
          playerBlocking
        );

        updateHud();

        if (playerHealth <= 0) {
          window.setTimeout(() => {
            finishRound("enemy");
          }, 620);

          return;
        }

        window.setTimeout(() => {
          endEnemyTurn();
        }, 620);
      }, randomBetween(380, 700));
    }

    function endEnemyTurn() {
      playerBlocking = false;
      enemyBlocking = false;

      playerFighter.classList.remove("blocking");
      enemyFighter.classList.remove("blocking");

      actionLocked = false;

      updateHud();
      setCombatText("Bob’s turn.");
    }

    function startTimer() {
      clearInterval(timerInterval);

      timerInterval = window.setInterval(() => {
        if (!fightActive || actionLocked && timeRemaining === 60) {
          return;
        }

        timeRemaining -= 1;

        if (timeRemaining <= 0) {
          timeRemaining = 0;
          updateHud();
          clearInterval(timerInterval);

          const winner =
            playerHealth >= enemyHealth ? "player" : "enemy";

          finishRound(winner, true);
          return;
        }

        updateHud();
      }, 1000);
    }

    function startRound() {
      clearTimeout(enemyTurnTimeout);

      playerHealth = 100;
      enemyHealth = 100;

      playerPower = 0;
      enemyPower = 0;

      timeRemaining = 60;

      playerBlocking = false;
      enemyBlocking = false;

      fightActive = false;
      actionLocked = true;

      playerFighter.className = "fighter";
      enemyFighter.className = "fighter enemy";

      restartButton.classList.remove("show");

      updateHud();

      announce("ROUND " + roundNumber);

      window.setTimeout(() => {
        announce("FIGHT!");
        playTone(130, 0.3, "sawtooth", 0.06, 65);
      }, 950);

      window.setTimeout(() => {
        fightActive = true;
        actionLocked = false;

        updateHud();
        startTimer();

        setCombatText("Bob’s turn. Choose an attack.");
      }, 1800);
    }

    function finishRound(winner, timeExpired = false) {
      if (!fightActive) {
        return;
      }

      fightActive = false;
      actionLocked = true;

      clearInterval(timerInterval);
      clearTimeout(enemyTurnTimeout);

      enableControls(false);

      if (winner === "player") {
        playerRounds += 1;
        enemyFighter.classList.add("defeated");

        announce(timeExpired ? "BOB WINS" : "BOB WINS");

        setCombatText(
          timeExpired
            ? "Time expires. Bob wins by remaining slightly less damaged."
            : "Flytrap is down. Bob remains unimpressed."
        );
      } else {
        enemyRounds += 1;
        playerFighter.classList.add("defeated");

        announce("FLYTRAP WINS");

        setCombatText(
          timeExpired
            ? "Time expires. Flytrap wins."
            : "Bob has been temporarily composted."
        );
      }

      updateHud();

      window.setTimeout(() => {
        if (playerRounds >= 2 || enemyRounds >= 2) {
          finishMatch();
        } else {
          roundNumber += 1;
          startRound();
        }
      }, 2100);
    }

    function finishMatch() {
      clearInterval(timerInterval);

      fightActive = false;
      actionLocked = true;

      if (playerRounds >= 2) {
        announce("BOB WINS");
        setCombatText(
          "Cracked, but never broken. McBride’s has a new champion."
        );
      } else {
        announce("GAME OVER");
        setCombatText(
          "Flytrap wins the tournament and immediately asks about lunch."
        );
      }

      restartButton.classList.add("show");
      restartButton.textContent = "Fight Again";

      specialButton.disabled = true;
      attackButtons.forEach((button) => {
        button.disabled = true;
      });
    }

    function openFinisher() {
      if (
        !fightActive ||
        actionLocked ||
        playerPower < 100 ||
        enemyHealth > 25
      ) {
        return;
      }

      actionLocked = true;
      enableControls(false);

      finisherOverlay.classList.add("show");
      playTone(72, 0.45, "sawtooth", 0.06, 35);
      vibrate([60, 40, 80]);
    }

    function executeFinisher() {
      finisherOverlay.classList.remove("show");

      playFinisherSound();

      playerFighter.classList.add("attack");

      window.setTimeout(() => {
        gameShell.classList.add("screen-shake");
        enemyFighter.classList.add("hit");

        createImpact(enemyFighter, 99);

        enemyHealth = 0;
        playerPower = 0;

        updateHud();

        announce("KINTSUGI CRUSH!");

        setCombatText(
          "Bob repairs what he breaks. Then checks whether the repair can take a punch."
        );

        vibrate([90, 40, 120, 60, 180]);
      }, 240);

      window.setTimeout(() => {
        playerFighter.classList.remove("attack");
        enemyFighter.classList.remove("hit");
        enemyFighter.classList.add("defeated");
        gameShell.classList.remove("screen-shake");

        finishRound("player");
      }, 1200);
    }

    function restartMatch() {
      playerRounds = 0;
      enemyRounds = 0;
      roundNumber = 1;

      playerRoundDots.forEach((dot) => {
        dot.classList.remove("won");
      });

      enemyRoundDots.forEach((dot) => {
        dot.classList.remove("won");
      });

      startRound();
    }

    attackButtons.forEach((button) => {
      button.addEventListener("click", () => {
        playerMove(button.dataset.move);
      });
    });

    specialButton.addEventListener("click", openFinisher);
    performFinisher.addEventListener("click", executeFinisher);
    restartButton.addEventListener("click", restartMatch);

    document.addEventListener("keydown", (event) => {
      const key = event.key.toLowerCase();

      if (key === "a") {
        playerMove("potShot");
      }

      if (key === "s") {
        playerMove("leafSlap");
      }

      if (key === "d") {
        playerMove("rootProblem");
      }

      if (key === "f") {
        playerMove("block");
      }

      if (key === " ") {
        event.preventDefault();
        openFinisher();
      }
    });

    window.addEventListener("load", () => {
      updateHud();

      window.setTimeout(() => {
        startRound();
      }, 500);
    });
  </script>
</body>
</html>
